{
  "name": "poplatky",
  "private": true,
  "description": "Poplatky za vysílání v Evropě: statický web bez buildu. Skripty slouží jen k testům a typové kontrole.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "e2e": "node tests/e2e.js",
    "audit": "python3 audit/recompute.py && python3 audit/reference_cases.py",
    "reference": "python3 audit/reference_cases.py",
    "sync": "node scripts/sync-static.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
